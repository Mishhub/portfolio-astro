---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Section from "@/components/ui/Section.astro";
import Container from "@/components/ui/Container.astro";
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Reveal from "@/components/ui/Reveal.astro";
import RoadmapTimeline from "@/components/ai/RoadmapTimeline.astro";
import TopicGroup from "@/components/ai/TopicGroup.astro";
import { breadcrumbSchema } from "@/lib/seo";
import { AI_COURSES, AI_TOPICS, AI_ROADMAP, AI_SHIPPED } from "@/data/ai-journey";
import type { Topic } from "@/data/ai-journey";

const origin = Astro.site!.origin;

const crumbs = [
  { name: "Home", href: "/" },
  { name: "AI Engineering" },
];

const jsonLd = breadcrumbSchema([
  { name: "Home", url: origin },
  { name: "AI Engineering", url: `${origin}/ai-engineering` },
]);

/** Topics grouped by stage, from fundamentals to production. */
const stages: { key: Topic["stage"]; label: string }[] = [
  { key: "foundations", label: "LLM foundations" },
  { key: "core", label: "Retrieval & grounding" },
  { key: "agents", label: "Agents & orchestration" },
  { key: "applied", label: "Production & tooling" },
];

const topicsByStage = stages
  .map((s) => ({ ...s, topics: AI_TOPICS.filter((t) => t.stage === s.key) }))
  .filter((s) => s.topics.length > 0);

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout
  title="AI Engineering — Agentic & Generative AI"
  description="Production agentic and generative AI: a multi-agent LangGraph assistant, an MCP-based PR-review agent and a RAG chatbot — after Ed Donner's AI Engineer tracks."
  jsonLd={jsonLd}
>
  <PageHeader
    eyebrow="AI Engineering"
    title="Agentic & generative AI, in production"
    lead="I build AI systems the way I build distributed systems — scoped, observable and tested. Here's the training behind that work, the stack I use, how I got here and what has shipped."
  >
    <Breadcrumbs slot="breadcrumbs" items={crumbs} class="mb-4" />
  </PageHeader>

  {/* (a) Training */}
  <Section
    eyebrow="Training"
    title="Ed Donner's AI Engineer programme — both tracks completed"
    size="wide"
    spacing="compact"
  >
    <div class="grid gap-5 lg:grid-cols-2">
      {
        AI_COURSES.map((course, i) => (
          <Reveal delay={i * 80}>
            <Card class="flex h-full flex-col p-7 sm:p-8">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <span
                    class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-border bg-subtle text-brand"
                    aria-hidden="true"
                  >
                    <Icon name="lucide:graduation-cap" class="size-5" />
                  </span>
                  <p class="text-sm text-muted-foreground">
                    {course.instructor} · {course.provider} · {course.year}
                  </p>
                </div>
                <Badge variant="success" size="md">
                  <Icon name="lucide:circle-check" class="size-3.5" aria-hidden="true" />
                  Completed
                </Badge>
              </div>
              <h3 class="mt-5 text-lg font-semibold tracking-tight text-foreground text-balance">
                {course.title}
              </h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">{course.blurb}</p>
              <div class="mt-6 flex grow items-end">
                <Button
                  href={course.credentialUrl}
                  external
                  variant="outline"
                  size="sm"
                  aria-label={`View certificate for ${course.title}`}
                >
                  View certificate
                  <Icon name="lucide:external-link" aria-hidden="true" />
                </Button>
              </div>
            </Card>
          </Reveal>
        ))
      }
    </div>
  </Section>

  {/* (b) Stack */}
  <Section
    eyebrow="Stack"
    title="What I work with"
    description="The tools and techniques behind the work, grouped from LLM fundamentals to production tooling."
    size="wide"
    spacing="compact"
  >
    <div class="grid gap-5 sm:grid-cols-2">
      {
        topicsByStage.map((s, i) => (
          <Reveal delay={i * 80}>
            <TopicGroup label={s.label} topics={s.topics} />
          </Reveal>
        ))
      }
    </div>
  </Section>

  {/* (c) Path */}
  <Section
    eyebrow="Path"
    title="From fundamentals to production"
    description="Each phase built on the last — ending with agents running in production, held to the same bar as any other system I operate."
    size="wide"
    spacing="compact"
  >
    <Container size="prose" class="px-0">
      <RoadmapTimeline milestones={AI_ROADMAP} />
    </Container>
  </Section>

  {/* (d) Shipped */}
  <Section
    eyebrow="Shipped"
    title="What I've shipped"
    description="AI systems running for real users — not demos."
    size="wide"
    spacing="compact"
  >
    <ul class="grid gap-px overflow-hidden rounded-2xl border border-border sm:grid-cols-3">
      {
        AI_SHIPPED.map((item, i) => (
          <Reveal as="li" delay={i * 80} class="flex flex-col gap-3 bg-card p-6">
            <div class="flex items-start gap-3">
              <Icon
                name="lucide:arrow-up-right"
                class="mt-0.5 size-5 shrink-0 text-brand"
                aria-hidden="true"
              />
              <div>
                <h3 class="font-semibold tracking-tight text-foreground">{item.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                  {item.description}
                </p>
              </div>
            </div>
            {item.href && (
              <a
                href={item.href}
                target={isExternal(item.href) ? "_blank" : undefined}
                rel={isExternal(item.href) ? "noopener noreferrer" : undefined}
                class="mt-auto inline-flex items-center gap-1.5 pl-8 text-sm font-medium text-foreground/70 transition-colors hover:text-foreground"
              >
                {item.linkLabel ?? "Learn more"}
                <Icon name="lucide:arrow-right" class="size-4" aria-hidden="true" />
              </a>
            )}
          </Reveal>
        ))
      }
    </ul>
  </Section>

  {/* (e) Engineering stance + CTAs */}
  <Section size="wide" spacing="compact">
    <Reveal>
      <div class="rounded-3xl border border-border bg-card p-8 sm:p-12">
        <h2 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
          Same rigour, new failure modes
        </h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">
          I treat AI systems like any other production system: least-privilege access,
          observability, graceful degradation and tests. What changes is how they fail —
          hallucination, prompt injection, leaked personal data, runaway cost — so grounding,
          guardrails, PII redaction and tracing are designed in from the first commit, not bolted on
          after the demo.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href="/case-studies/multi-agent-ai-assistant" variant="brand" size="md">
            <Icon name="lucide:layers" />
            Read the AI case study
          </Button>
          <Button href="https://github.com/Mishhub/chatbot-api" external variant="outline" size="md">
            <Icon name="lucide:github" />
            Browse the chatbot source
          </Button>
        </div>
      </div>
    </Reveal>
  </Section>
</BaseLayout>
